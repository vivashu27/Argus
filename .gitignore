# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Environments
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Scan output — contains hostnames, local file paths and findings about the
# machine it ran on. Never commit these.
#
# The directories are listed as well as the filename patterns. Every file under
# output/ happened to match argus-report-*, so the folder looked ignored while
# actually being ignored one file at a time — a report saved under any other name
# would have been committed by the next `git add -A`.
reports/
output/
argus_output/
argus-output/
*.sarif
argus-report-*
Argus Security Report*

# Local scanner configuration
argus.yaml

# Credentials. Argus reads provider keys from the environment only, so a .env here
# is a local convenience file and must never be committed — this repository is
# public, and `git add -A` does not ask.
.env
.env.*
!.env.example

# Local working files, not part of the project
project_outline.txt
claude_session

# This checkout's own agent tooling — Claude Code config, the graft MCP server
# registration, and the ripgrep rule that re-admits graft's cards to search.
# None of it belongs to Argus: graft is not a dependency, appears in no README or
# doc, and is in no clone's PATH.
#
# .claude/settings.json is the reason this is a security matter and not just
# tidiness. It registers SessionStart, PostToolUse, UserPromptSubmit and Stop
# hooks that run .claude/helpers/graft-hooks.cjs, so anyone who cloned this repo
# and opened it in Claude Code executed a file out of it without being asked —
# the exact shape Argus's own AASB hook checks exist to report. The helpers also
# hardcode /usr/local/lib/node_modules/@nanonets/graft, which is one machine's
# path and no one else's.
#
# Anchored. Unanchored, `.claude/` would match at every depth and swallow the
# fixture directories the test suite builds; that class of mistake already cost
# this file two comments below.
/.claude/
/.mcp.json
/.ignore
/CLAUDE.md

# Serena's project cache — pickled symbol data and a local override file. It was
# never ignored, so the next `git add -A` would have committed the .pkl files.
/.serena/

# Local rule authoring — personal templates, not part of the project.
# Anchored. Unanchored, this matched at every depth and was quietly ignoring nine
# tracked files under argus/rules/ and examples/rules/ — so a new module added
# there would have been invisible to `git add -A` and shipped missing.
/rules/

# graft's local graph cache — regenerable, not committed (run `graft build`).
# Anchored: unanchored, this also matched .claude/skills/graft/, so the tracked
# SKILL.md there was shadowed and edits to it would not have been picked up by
# `git add -A`. Same failure the /rules/ entry above was fixed for.
/graft/

# Editor and OS droppings
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Build and environment leftovers
node_modules/
*.log
.tox/
.direnv/

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/
